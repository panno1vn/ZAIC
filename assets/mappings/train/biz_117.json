{
  "industry": "vật liệu xây dựng",
  "record_grain": "order",
  "notes": [
    "Mapping tay từ README biz_117: sổ ghi tay chuyển Excel, mỗi tháng một sheet, header 2 dòng, dòng 'Tổng tháng' và chú thích cuối sheet (loader bỏ).",
    "Ngày lập ghi 4 kiểu ('1/1' không năm, '01/01/2025', '1 thg 1 2025', serial); Giờ là ngày giờ đầy đủ, trùng ngày với Ngày lập ở mọi dòng: dùng Giờ (has_time).",
    "Trả hàng: dòng số lượng âm cùng mã đơn, mọi dòng của đơn đó ghi trạng thái trả; khách lẻ ghi 3 kiểu.",
    "Tồn thực là tồn hết ngày cuối có dữ liệu (README: 20/05/2026)."
  ],
  "tables": [
    {
      "target": "orders",
      "sources": ["SoBanHang.xlsx::*"],
      "columns": [
        {"target": "order_id", "source": "Mã phiếu"},
        {"target": "order_time", "source": "Giờ", "parse": "datetime"},
        {"target": "has_time", "const": true},
        {"target": "status", "source": "Ghi chú TT", "transform": "order_status_from_lines"},
        {"target": "customer_key", "source": "TenKH"},
        {"target": "customer_name", "source": "TenKH"}
      ],
      "value_maps": {
        "status": {"Thành công": "completed", "đã lấy": "completed", "Đã hoàn thành": "completed", "hủy": "cancelled",
                   "Hủy": "cancelled", "trả lại": "returned", "Đã trả hàng": "returned", "Đang giao": "delivering",
                   "đang gửi": "delivering"},
        "customer_key": {"Khách lẻ": "", "khách lẻ": "", "lẻ": ""}
      }
    },
    {
      "target": "lines",
      "sources": ["SoBanHang.xlsx::*"],
      "columns": [
        {"target": "order_id", "source": "Mã phiếu"},
        {"target": "product_key", "source": "Tên SP"},
        {"target": "product_name", "source": "Tên SP"},
        {"target": "is_item", "const": true},
        {"target": "qty", "source": "Số lượng hàng", "parse": "qty"},
        {"target": "unit", "source": "DonVi"},
        {"target": "unit_price", "source": "Giá", "parse": "money"},
        {"target": "line_amount", "source": "Tiền", "parse": "money"}
      ]
    },
    {
      "target": "unit_conversions",
      "sources": ["DanhMuc.xlsx::Sheet1"],
      "columns": [
        {"target": "product_key", "source": "Hàng"},
        {"target": "unit", "source": "ĐV lớn"},
        {"target": "factor", "source": "Hệ số QĐ", "parse": "number"},
        {"target": "base_unit", "source": "ĐV nhỏ"}
      ]
    },
    {
      "target": "deliveries",
      "sources": ["SoGiaoHang.xlsx::Sheet1"],
      "columns": [
        {"target": "order_id", "source": "Mã bill"},
        {"target": "delivery_time", "source": "Ngày chở", "parse": "datetime"},
        {"target": "batch_no", "source": "Lượt giao", "parse": "number"}
      ]
    },
    {
      "target": "price_history",
      "sources": ["BangGia.xlsx::Sheet1"],
      "columns": [
        {"target": "product_key", "source": "TenHang"},
        {"target": "effective_date", "source": "Ngày áp dụng", "parse": "date"},
        {"target": "price", "source": "Giá mới", "parse": "money"}
      ]
    },
    {
      "target": "purchases",
      "sources": ["SoNhapHang.xlsx::Sheet1"],
      "columns": [
        {"target": "receipt_id", "source": "Số phiếu"},
        {"target": "receipt_time", "source": "Ngày nhập", "parse": "datetime"},
        {"target": "supplier", "source": "Nhà cung cấp"},
        {"target": "product_key", "source": "Product"},
        {"target": "qty", "source": "SL nhập", "parse": "qty"},
        {"target": "unit", "source": "ĐVT"},
        {"target": "unit_cost", "source": "Giá nhập", "parse": "money"},
        {"target": "amount", "source": "Thành tiền", "parse": "money"},
        {"target": "note", "source": "Nội dung"}
      ]
    },
    {
      "target": "inventory",
      "sources": ["TonKho.xlsx::Sheet1"],
      "columns": [
        {"target": "product_key", "source": "Product"},
        {"target": "as_of", "const": "2026-05-20", "parse": "date"},
        {"target": "base_qty", "source": "Tồn thực", "parse": "qty"}
      ]
    }
  ],
  "extra_tables": [
    {"name": "han_no", "sources": ["SoHanNo.xlsx::Sheet1"],
     "description": "hạn thanh toán của đơn bán nợ: số ngày được nợ tính từ ngày đặt và ngày phải trả hết",
     "column_notes": {"So hoa don": "mã đơn", "Hạn nợ (ngày)": "số ngày được nợ", "Han tra": "hạn thanh toán"}}
  ]
}

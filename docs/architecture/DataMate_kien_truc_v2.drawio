<mxfile host="Claude" version="24.7.0"><diagram id="datamate-v2" name="Kiến trúc v2"><mxGraphModel dx="1500" dy="2050" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="2050" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="DataMate — Kiến trúc v2 (gộp bản vẽ của nhóm + bổ sung) · 02/11/2026" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontFamily=Helvetica;fontSize=20;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="30" y="22" width="900" height="26" as="geometry"/></mxCell><mxCell id="subtitle" value="Nguyên tắc: LLM chỉ hiểu &amp; trích xuất · mọi phép tính do code · không chắc thì bỏ trống (đúng +1, sai −1, bỏ trống 0)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontFamily=Helvetica;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="30" y="52" width="900" height="18" as="geometry"/></mxCell><mxCell id="g1" value="1. Dữ liệu đầu vào — /data (chỉ đọc)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDF2FD;strokeColor=#E3A3E3;verticalAlign=top;align=left;spacingLeft=12;spacingTop=2;fontStyle=1;fontSize=13;fontColor=#333333;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="80" width="1130" height="150" as="geometry"/></mxCell><mxCell id="g2" value="2. Lõi xử lý (Core Pipeline)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F1FAF8;strokeColor=#8ED1C6;verticalAlign=top;align=left;spacingLeft=12;spacingTop=2;fontStyle=1;fontSize=13;fontColor=#333333;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="260" width="1130" height="1120" as="geometry"/></mxCell><mxCell id="g2a" value="2a. Mỗi cửa hàng — chạy 1 lần, lưu cache" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9CCFC6;verticalAlign=top;align=left;spacingLeft=12;spacingTop=2;fontStyle=1;fontSize=13;fontColor=#333333;fontFamily=Helvetica;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="50" y="295" width="510" height="620" as="geometry"/></mxCell><mxCell id="g2b" value="2b. Mỗi câu hỏi" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9CCFC6;verticalAlign=top;align=left;spacingLeft=12;spacingTop=2;fontStyle=1;fontSize=13;fontColor=#333333;fontFamily=Helvetica;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="600" y="295" width="540" height="385" as="geometry"/></mxCell><mxCell id="g3" value="3. Quyết định &amp; định dạng câu trả lời" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF7EE;strokeColor=#EDB37E;verticalAlign=top;align=left;spacingLeft=12;spacingTop=2;fontStyle=1;fontSize=13;fontColor=#333333;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="1410" width="1130" height="340" as="geometry"/></mxCell><mxCell id="g4" value="4. Đầu ra &amp; log — /result" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFFAFC;strokeColor=#86CFDB;verticalAlign=top;align=left;spacingLeft=12;spacingTop=2;fontStyle=1;fontSize=13;fontColor=#333333;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="1790" width="1130" height="230" as="geometry"/></mxCell><mxCell id="in_files" value="&lt;b&gt;data/&amp;lt;biz&amp;gt;/&lt;/b&gt;&lt;br&gt;*.csv · *.xlsx · *.sqlite" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="60" y="115" width="210" height="90" as="geometry"/></mxCell><mxCell id="in_readme" value="&lt;b&gt;data/&amp;lt;biz&amp;gt;/README.md&lt;/b&gt;&lt;br&gt;mô tả, chất lượng không đều" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="300" y="115" width="210" height="90" as="geometry"/></mxCell><mxCell id="in_q" value="&lt;b&gt;questions.jsonl&lt;/b&gt;&lt;br&gt;id, business_id,&lt;br&gt;question, as_of_date" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="600" y="115" width="210" height="90" as="geometry"/></mxCell><mxCell id="in_cal" value="&lt;b&gt;calendar.csv&lt;/b&gt;&lt;br&gt;lịch âm – dương, Tết" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="840" y="115" width="150" height="90" as="geometry"/></mxCell><mxCell id="in_rule" value="&lt;b&gt;rulebook.md&lt;/b&gt;&lt;br&gt;luật của split" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="1010" y="115" width="140" height="90" as="geometry"/></mxCell><mxCell id="A" value="&lt;b&gt;[A] Data Ingestion — đọc + làm sạch&lt;/b&gt;&lt;br&gt;đọc mọi file / sheet / bảng · dò header · truy vết nguồn&lt;br&gt;parse tiền (25k, 30.500đ), ngày (serial Excel, 1/6), số lượng&lt;br&gt;điền ô trống theo nhóm, bỏ dòng trùng trong đơn (§8)&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#555555&quot;&gt;J1&lt;/font&gt;&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="105" y="335" width="400" height="110" as="geometry"/></mxCell><mxCell id="A2" value="&lt;b&gt;[A2] Profiling &amp;amp; Schema Discovery&lt;/b&gt;&lt;br&gt;cột, kiểu, NULL, khóa, quan hệ giữa các bảng&lt;br&gt;giá trị mẫu, khoảng ngày, đơn vị, bất thường&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#555555&quot;&gt;J1&lt;/font&gt;&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="105" y="480" width="400" height="95" as="geometry"/></mxCell><mxCell id="B" value="&lt;b&gt;[B] Mapping về schema chuẩn&lt;/b&gt;&lt;br&gt;luật đồng nghĩa tên cột + LLM (README bổ trợ)&lt;br&gt;nhận diện ngành (§6) · quy đổi về đơn vị cơ bản&lt;br&gt;trạng thái → hoàn thành / huỷ / trả hàng / đang giao&lt;br&gt;kiểm tra chéo: tổng dòng = tổng đơn, khoảng ngày, khóa&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#555555&quot;&gt;Senior&lt;/font&gt;&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="105" y="610" width="400" height="130" as="geometry"/></mxCell><mxCell id="T" value="&lt;b&gt;Bảng chuẩn + data card (cache)&lt;/b&gt;&lt;br&gt;orders · lines · products · payments · returns&lt;br&gt;purchases · inventory · price_history · lots · expenses&lt;br&gt;mapping không qua kiểm tra → đánh dấu tin cậy thấp" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="105" y="775" width="400" height="120" as="geometry"/></mxCell><mxCell id="C" value="&lt;b&gt;[C] Question Understanding&lt;/b&gt;&lt;br&gt;chuẩn hoá tiếng Việt: thêm dấu, mở viết tắt (dthu, bnhiu, th7…)&lt;br&gt;LLM → kế hoạch truy vấn JSON (structured output):&lt;br&gt;loại câu · chỉ số · bộ lọc · kỳ dạng ký hiệu · kiểu đáp án&lt;br&gt;ví dụ mẫu lấy từ kho train (BM25)&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#555555&quot;&gt;Senior&lt;/font&gt;&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="640" y="335" width="460" height="140" as="geometry"/></mxCell><mxCell id="C2" value="&lt;b&gt;[C2] Temporal Engine — bộ tính ngày&lt;/b&gt;&lt;br&gt;kỳ ký hiệu + as_of_date → ngày bắt đầu / kết thúc (§2)&lt;br&gt;tuần T2–CN · cùng kỳ · quý không ghi năm · Tết (lịch âm)&lt;br&gt;bỏ bản ghi sau as_of_date&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#555555&quot;&gt;J2&lt;/font&gt;&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="640" y="520" width="460" height="120" as="geometry"/></mxCell><mxCell id="C3" value="&lt;b&gt;[C3] Schema / Entity Linking&lt;/b&gt;&lt;br&gt;nối tên / mã hàng, khách, nhóm, kênh với data card (RapidFuzz, so khớp không dấu)&lt;br&gt;kiểm tra trường cần dùng có trong bảng chuẩn không (thiếu → tín hiệu unanswerable)&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#555555&quot;&gt;Senior + J3&lt;/font&gt;&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="250" y="960" width="660" height="100" as="geometry"/></mxCell><mxCell id="D1" value="&lt;b&gt;[D1] Thư viện hàm — đường chính&lt;/b&gt;&lt;br&gt;cài đúng rulebook: đơn hợp lệ, doanh thu,&lt;br&gt;xếp hạng, công nợ, tồn kho, nhập hàng…&lt;br&gt;pandas · kết quả xác định · kiểm trên 3000 câu train&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#555555&quot;&gt;J3 + J2&lt;/font&gt;&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="150" y="1100" width="350" height="110" as="geometry"/></mxCell><mxCell id="D2" value="&lt;b&gt;[D2] Sinh code SQL / Python — dự phòng&lt;/b&gt;&lt;br&gt;chỉ cho câu ngoài thư viện hàm&lt;br&gt;sandbox, timeout, file tạm ở /tmp&lt;br&gt;không đưa cả bảng vào prompt&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#555555&quot;&gt;Senior · nếu kịp&lt;/font&gt;&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=1.3;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="560" y="1100" width="350" height="110" as="geometry"/></mxCell><mxCell id="R" value="&lt;b&gt;[R] Kiểm tra rulebook&lt;/b&gt;&lt;br&gt;1 lần mỗi split&lt;br&gt;luật mà hàm dựa vào&lt;br&gt;bị đổi / mất → hạ tin cậy&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#555555&quot;&gt;Bạn&lt;/font&gt;&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="950" y="1100" width="190" height="110" as="geometry"/></mxCell><mxCell id="V" value="&lt;b&gt;[V] Result Validation — kiểm tra kết quả&lt;/b&gt;&lt;br&gt;nhân dòng do join · ranh giới thời gian · đơn vị · mẫu số 0&lt;br&gt;kiểu đáp án khớp câu hỏi · D1 và D2 có khớp nhau · giá trị bất thường → tín hiệu tin cậy&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#555555&quot;&gt;Bạn&lt;/font&gt;&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="250" y="1250" width="660" height="100" as="geometry"/></mxCell><mxCell id="E" value="&lt;b&gt;[E] Đủ mọi cổng&lt;/b&gt;&lt;br&gt;&lt;b&gt;&amp;amp; tin cậy &amp;gt; ngưỡng?&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#555555&quot;&gt;Bạn&lt;/font&gt;&lt;/i&gt;" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="410" y="1430" width="340" height="120" as="geometry"/></mxCell><mxCell id="gate" value="&lt;b&gt;Cổng trả lời (thiếu 1 → không trả lời)&lt;/b&gt;&lt;br&gt;• nhận ra loại câu · nối được thực thể&lt;br&gt;• mapping qua kiểm tra · kỳ hỏi có dữ liệu&lt;br&gt;• kết quả hợp lý · luật không đổi&lt;br&gt;Ngưỡng chọn trên train, vì sai bị −1" style="shape=note;size=14;backgroundOutline=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;fillColor=#FFFFFF;strokeColor=#9A9A9A;strokeWidth=1.3;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="860" y="1440" width="280" height="120" as="geometry"/></mxCell><mxCell id="F" value="&lt;b&gt;[F] Format §9 → câu trả lời có kiểu&lt;/b&gt;&lt;br&gt;string | number | percent | date | boolean | list | table&lt;br&gt;tiền làm tròn về đồng (nửa lên) · % 2 chữ số&lt;br&gt;date YYYY-MM-DD / YYYY-MM · list đúng thứ tự&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#555555&quot;&gt;J2&lt;/font&gt;&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="90" y="1610" width="340" height="110" as="geometry"/></mxCell><mxCell id="U" value="&lt;b&gt;unanswerable&lt;/b&gt;&lt;br&gt;chỉ khi chắc chắn:&lt;br&gt;kỳ hỏi nằm hẳn ngoài dữ liệu,&lt;br&gt;hoặc shop không ghi loại&lt;br&gt;thông tin đó (đã xác nhận)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="470" y="1610" width="220" height="110" as="geometry"/></mxCell><mxCell id="Ab" value="&lt;b&gt;abstain (bỏ trống)&lt;/b&gt;&lt;br&gt;không chắc · lỗi thực thi&lt;br&gt;thiếu cột chưa xác nhận&lt;br&gt;→ 0 điểm thay vì −1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="730" y="1610" width="260" height="110" as="geometry"/></mxCell><mxCell id="O_sub" value="&lt;b&gt;/result/submission.jsonl&lt;/b&gt;&lt;br&gt;đúng 1 dòng / câu · ghi từng dòng ngay khi có&lt;br&gt;(quá 6 giờ thì chỉ chấm các dòng đã ghi)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="200" y="1830" width="420" height="95" as="geometry"/></mxCell><mxCell id="O_log" value="&lt;b&gt;/result/logs/&amp;lt;id&amp;gt;.json&lt;/b&gt;&lt;br&gt;id, đáp án, thời gian, kế hoạch JSON,&lt;br&gt;code + output, tín hiệu, độ tin cậy" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="680" y="1830" width="420" height="95" as="geometry"/></mxCell><mxCell id="guard" value="&lt;b&gt;Đồng hồ chặn&lt;/b&gt;&lt;br&gt;gần hết 6 giờ → ghi abstain cho phần còn lại · Bạn" style="shape=note;size=14;backgroundOutline=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;fillColor=#FFFFFF;strokeColor=#9A9A9A;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="200" y="1945" width="420" height="60" as="geometry"/></mxCell><mxCell id="S_change" value="&lt;b&gt;Thay đổi chính so với bản của nhóm&lt;/b&gt;&lt;br&gt;1. Map về schema chuẩn, 1 lần mỗi cửa hàng&lt;br&gt;2. Thư viện hàm là chính, sinh code dự phòng&lt;br&gt;3. Tính ngày sau khi hiểu câu hỏi&lt;br&gt;4. Cổng tin cậy; unanswerable khi chắc chắn&lt;br&gt;5. Thêm LLM ≤15B, Docker, đồng hồ, log" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;fillColor=#FFF5F5;strokeColor=#C0392B;strokeWidth=1.3;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1190" y="80" width="280" height="150" as="geometry"/></mxCell><mxCell id="S_llm" value="&lt;b&gt;LLM dùng chung&lt;/b&gt;&lt;br&gt;Qwen3-14B · ≤ 15 tỉ tham số&lt;br&gt;Apache-2.0 · chạy bằng vLLM&lt;br&gt;temperature 0 · seed cố định&lt;br&gt;gọi từ [B] [C] [D2]&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#555555&quot;&gt;Senior&lt;/font&gt;&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="1190" y="260" width="280" height="140" as="geometry"/></mxCell><mxCell id="S_env" value="&lt;b&gt;Môi trường chạy&lt;/b&gt;&lt;br&gt;Docker · offline, tắt mạng&lt;br&gt;2× RTX 5090 32GB · RAM 512GB&lt;br&gt;≤ 6 giờ cho cả private test&lt;br&gt;/data chỉ đọc · file tạm ở /tmp" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="1190" y="420" width="280" height="140" as="geometry"/></mxCell><mxCell id="S_dev" value="&lt;b&gt;Chuẩn bị từ train&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#555555&quot;&gt;ngoài Docker · chỉ dùng dữ liệu train&lt;/font&gt;&lt;/i&gt;&lt;br&gt;• kho ví dụ đã kiểm chứng → [C]&lt;br&gt;• từ điển viết tắt, luật đồng nghĩa → [B] [C]&lt;br&gt;• mapping tay 8 cửa hàng → đánh giá [B]&lt;br&gt;• scorer + đánh giá theo ngành → ngưỡng [E]&lt;br&gt;→ đóng gói vào image&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#555555&quot;&gt;(luật thi cấm dùng dữ liệu test)&lt;/font&gt;&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;fillColor=#F7F7F7;strokeColor=#888888;strokeWidth=1.3;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1190" y="580" width="280" height="170" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.3;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5875;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="in_files" target="A"><mxGeometry relati